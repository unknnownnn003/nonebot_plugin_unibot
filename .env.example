# Host configuration template only. Never commit an actual .env.
# Enable only after HTTPS callback and access logging are configured.
LXNS_OAUTH_ENABLED=false
LXNS_OAUTH_CLIENT_ID="replace-with-client-id"
LXNS_OAUTH_CLIENT_SECRET="replace-with-client-secret"
LXNS_OAUTH_REDIRECT_URI="https://bot.example.com/oauth/lxns/callback"
# Generate privately using Fernet.generate_key(); keep outside data backups.
LXNS_OAUTH_ENCRYPTION_KEY="replace-with-fernet-key"
